<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The same RAG and review sources as BimSAgent; no Revit/MCP/interactive memory dependencies. -->
    <Compile Include="../../Rag/*.cs" Exclude="../../Rag/RagCommands.cs;../../Rag/RagChatCommands.cs" Link="Rag/%(Filename)%(Extension)" />
    <Compile Include="../../Review/*.cs" Link="Review/%(Filename)%(Extension)" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PdfPig" Version="0.1.11" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.0" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="9.0.14" />
  </ItemGroup>
</Project>
