<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RevitApiDirectory Condition="'$(RevitApiDirectory)' == ''">D:\Useful Programs\Revit 2024</RevitApiDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <EmbeddedResource Include="BIM-S.png" LogicalName="BimS.Revit2024.BIM-S.png" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDirectory)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDirectory)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
